{
    "name": "note-web",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "test": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:6000 && electron .\"",
        "electron:build": "vite build && electron-builder"
    },
    "dependencies": {
        "@ant-design/icons": "^5.6.1",
        "antd": "^5.12.0",
        "axios": "^1.13.6",
        "echarts": "^5.4.3",
        "fabric": "^5.3.0",
        "howler": "^2.2.4",
        "i18next": "^25.5.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-i18next": "^13.5.0",
        "react-router-dom": "^6.30.3",
        "slate": "^0.124.0",
        "slate-history": "^0.113.1",
        "slate-react": "^0.124.0",
        "zustand": "^4.5.5"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^6.4.2",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.5.2",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^9.2.1",
        "electron": "^39.8.0",
        "electron-builder": "^26.8.0",
        "eslint": "^8.55.0",
        "eslint-plugin-react": "^7.33.2",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jsdom": "^24.0.0",
        "prettier": "^3.1.1",
        "vite": "^5.0.8",
        "vitest": "^1.6.0",
        "wait-on": "^7.2.0"
    }
}