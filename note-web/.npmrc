react=^19.0.0
react-dom=^19.0.0

# 构建工具
vite=^5.0.8

# 状态管理
zustand=^4.5.5

# 路由
react-router-dom=^6.30.3

# UI 组件库
antd=^5.12.0
@ant-design/icons=^5.6.1

# 国际化
react-i18next=^13.5.0
i18next=^25.5.2

# HTTP 客户端
axios=^1.13.6

# 类型定义
@types/react=^19.0.0
@types/react-dom=^19.0.0

# Vite 插件
@vitejs/plugin-react=^4.2.1

# 代码规范
eslint=^8.55.0
prettier=^3.1.1

# 桌面框架
electron=^39.8.0
electron-builder=^26.8.0

# 并发工具
concurrently=^9.2.1
wait-on=^7.2.0
